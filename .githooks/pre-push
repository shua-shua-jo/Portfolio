#!/bin/sh

echo ""
echo "=========================================="
echo "        🚀 PRE-PUSH CHECK"
echo "=========================================="
echo ""

FOOTER_FILE="src/lib/components/Footer.svelte"

CURRENT_YEAR=$(date +"%Y")

# ------------------------------------------
# CHECK FOOTER YEAR
# ------------------------------------------

if [ ! -f "$FOOTER_FILE" ]; then
    echo "⚠️  Footer file not found:"
    echo "   $FOOTER_FILE"
    echo ""
    exit 1
fi

FOOTER_YEAR=$(grep -oE '©[[:space:]]*[0-9]{4}' "$FOOTER_FILE" | head -1 | grep -oE '[0-9]{4}')

if [ -z "$FOOTER_YEAR" ]; then
    echo "⚠️  Could not find footer year."
    echo ""
    exit 1
fi

if [ "$FOOTER_YEAR" != "$CURRENT_YEAR" ]; then
    echo "❌ FOOTER YEAR IS OUTDATED!"
    echo ""
    echo "   Found:    $FOOTER_YEAR"
    echo "   Expected: $CURRENT_YEAR"
    echo ""
    echo "Push cancelled."
    exit 1
fi

echo "✅ Footer year is correct: $FOOTER_YEAR"

echo ""
echo "=========================================="
echo "✅ Pre-push check passed!"
echo "🚀 Continuing push..."
echo "=========================================="
echo ""

exit 0